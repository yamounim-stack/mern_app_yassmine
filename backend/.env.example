# Copier ce fichier en ".env" puis remplacer par vos vraies valeurs.
# Le vrai fichier .env ne doit JAMAIS être committé.
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/<base>?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development
# Origines frontend autorisées (séparées par des virgules, sans "/" final)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
